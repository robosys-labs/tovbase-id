DATABASE_URL=sqlite:///./data/tovbase_id.db
DID_METHOD=tov
DID_NODE_ID=tovbase-id-dev-1
DID_SIGNING_KEY_ID=tovbase-registry-dev-1
# Base64url-encoded raw Ed25519 private key bytes. Leave blank for an ephemeral dev key.
DID_SIGNING_PRIVATE_KEY_B64=
# JSON array of retired/extra public keys for old receipt verification.
DID_VERIFYING_KEYS_JSON=
# JSON array of trusted bank attestation public keys.
TRUSTED_BANK_KEYS_JSON=
REGISTRY_PUBLICATION_NAME=did_registry_publication
ACTION_CHALLENGE_TTL_SECONDS=300
